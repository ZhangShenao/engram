# Leave the key empty to use the scripted provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

CHARACTER_URL=http://127.0.0.1:18411
CONVERSATION_URL=http://127.0.0.1:18412
MEMORY_URL=http://127.0.0.1:18413
HARNESS_URL=http://127.0.0.1:18414
GATEWAY_URL=http://127.0.0.1:18410
WEB_ORIGIN=http://127.0.0.1:18415

CHARACTER_DATABASE_URL=postgresql://engram:engram@127.0.0.1:5432/engram_character
CONVERSATION_DATABASE_URL=postgresql://engram:engram@127.0.0.1:5432/engram_conversation
MEMORY_DATABASE_URL=postgresql://engram:engram@127.0.0.1:5432/engram_memory
HARNESS_DATABASE_URL=postgresql://engram:engram@127.0.0.1:5432/engram_harness
GATEWAY_DATABASE_URL=postgresql://engram:engram@127.0.0.1:5432/engram_gateway

# Host port for the Compose Postgres. Change it when another Postgres already listens on 5432.
# For `scripts/dev.sh local`, change the port in the *_DATABASE_URL values above as well.
POSTGRES_PORT=5432
