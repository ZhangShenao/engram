# Leave the key empty to use the scripted provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GATEWAY_URL=http://127.0.0.1:18410
CONTEXT_TARGET=127.0.0.1:18411
MEMORY_TARGET=127.0.0.1:18413
LLM_TARGET=127.0.0.1:18414
WEB_ORIGIN=http://127.0.0.1:18415

CHAT_DATABASE_URL=postgresql://engram:engram@127.0.0.1:5432/engram_chat
CONTEXT_DATABASE_URL=postgresql://engram:engram@127.0.0.1:5432/engram_context
MEMORY_DATABASE_URL=postgresql://engram:engram@127.0.0.1:5432/engram_memory
MQ_DATABASE_URL=postgresql://engram:engram@127.0.0.1:5432/engram_mq

# Host port for the Compose Postgres. Change it when another Postgres already listens on 5432.
# For `scripts/dev.sh local`, change the port in the *_DATABASE_URL values above as well.
POSTGRES_PORT=5432
